# Copy this to .env and fill values for local development (DO NOT COMMIT .env)

# Preferred: single connection string (Aiven/managed services)
# Example: mysql://user:pass@host:port/dbname?ssl-mode=REQUIRED
DATABASE_URL=

# Or: individual settings
DB_NAME=backend_variety
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_DIALECT=mysql

# Optional
DB_SSL=true
DB_SSL_ALLOW_SELF_SIGNED=false

# JWT secret for auth
TOKEN_SECRET=your_jwt_secret_here
