 # Copy this to .env and fill values for local development (DO NOT COMMIT .env)

# Preferred: single connection string (Aiven/managed services)
# Example: mysql://user:pass@host:port/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=

# Or: individual settings (used when DATABASE_URL is not provided)
DB_NAME=backend_variety
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_DIALECT=mysql

# SSL options (use only for testing; prefer proper CA certificates in production)
DB_SSL=false
DB_SSL_ALLOW_SELF_SIGNED=false

# JWT secret for auth
JWT_SECRET=your_jwt_secret_here

# Allow comma-separated origins for CORS (Netlify frontend + localhost)
# Example: ORIGINS=https://serene-swan-2b9f44.netlify.app,http://localhost:5173
ORIGINS=

# Tune DB pool max connections
DB_POOL_MAX=5
